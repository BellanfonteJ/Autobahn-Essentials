<section class="section">
  <div class="page-width">
    <div class="section-heading">
      <div>
        <div class="eyebrow">{{ 'general.search.search' | t }}</div>
        <h1>{{ 'general.search.title' | t }}</h1>
      </div>
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <label class="visually-hidden" for="SearchQuery">{{ 'general.search.search' | t }}</label>
      <input id="SearchQuery" class="field" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
      <button class="button" type="submit">{{ 'general.search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      <div
        class="garage-fitment-filter"
        data-fitment-filter-controls
      >
        <label class="garage-fitment-filter__toggle">
          <input type="checkbox" data-fitment-filter-toggle>
          <span>Show listed model / engine matches</span>
        </label>
        <button class="button button--secondary" type="button" data-garage-open>My Garage</button>
        <button class="button button--secondary" type="button" data-fitment-retry hidden>Retry</button>
        <p data-fitment-filter-status>Save a vehicle in My Garage to filter these results.</p>
      </div>

      <div class="section-heading section--tight">
        {%- assign escaped_search_terms = search.terms | escape -%}
        <p data-search-result-count="{{ search.results_count }}">{{ 'general.search.results_with_count' | t: count: search.results_count, terms: escaped_search_terms }}</p>
      </div>

      {%- paginate search.results by 12 -%}
        <div class="search-grid" data-fitment-grid data-fitment-section="{{ section.id }}" data-fitment-pages="{{ paginate.pages }}" data-fitment-page="{{ paginate.current_page | default: 1 }}" data-fitment-url="{{ routes.search_url | escape }}">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <article class="article-card">
                <div class="article-card__info">
                  <div class="eyebrow">{{ item.object_type }}</div>
                  <h3 class="article-card__title"><a href="{{ item.url }}">{{ item.title | escape }}</a></h3>
                  <p>{{ item.content | strip_html | truncate: 120 }}</p>
                </div>
              </article>
            {%- endif -%}
          {%- else -%}
            <div class="empty-state">{{ 'general.search.no_results' | t }}</div>
          {%- endfor -%}
        </div>
        <div class="empty-state" data-fitment-empty hidden>No listed model / engine matches. Products without fitment data are excluded; contact us to confirm compatibility.</div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" data-fitment-pagination role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
            {{ paginate | default_pagination }}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search"
}
{% endschema %}
