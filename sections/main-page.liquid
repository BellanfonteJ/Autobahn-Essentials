{%- if page.handle == 'builds' and page.content == blank -%}
  {% render 'breadcrumbs' %}
  {% render 'builds-content', section: section %}
{%- elsif page.handle == 'returns' and page.content == blank -%}
  {% render 'breadcrumbs' %}
  {% render 'returns-content', section: section %}
{%- else -%}
{% render 'breadcrumbs' %}

<section class="section">
  <div class="page-width">
    <div class="section-heading">
      <div>
        <div class="eyebrow">{{ shop.name }}</div>
        <h1>{{ page.title }}</h1>
      </div>
    </div>
    <div class="rte">{{ page.content }}</div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Page"
}
{% endschema %}
