{% render 'breadcrumbs' %}

{%- liquid
  assign contact_form_id = 'ContactForm-' | append: section.id
  assign contact_heading_id = contact_form_id | append: '-heading'
  assign contact_error_id = contact_form_id | append: '-errors'
  assign contact_email = shop.email | default: section.settings.fallback_email | strip
  assign contact_topics = 'Fitment check|Order support|Build advice|Wholesale' | split: '|'
  assign contact_shipping_url = shop.shipping_policy.url | default: pages['shipping-returns'].url
  assign contact_returns_url = pages['returns'].url | default: shop.refund_policy.url
-%}
<section class="ae-contact-page">
  <div class="page-width">
    <header class="ae-contact-page__heading">
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
      <h1>{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
    </header>

    <div class="ae-contact-layout">
      <div class="ae-contact-main">
        <h2 id="{{ contact_heading_id }}">{{ section.settings.form_heading | escape }}</h2>
        {%- form 'contact', id: contact_form_id, class: 'ae-contact-form', aria-labelledby: contact_heading_id -%}
        {%- if form.posted_successfully? -%}
          <div class="ae-form-status ae-contact-form__wide" role="status">{{ section.settings.success_text | escape }}</div>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="ae-form-status ae-contact-form__wide" id="{{ contact_error_id }}" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="ae-contact-field">
          <label for="{{ contact_form_id }}-name">Name <span aria-hidden="true">*</span></label>
          <input id="{{ contact_form_id }}-name" class="field" type="text" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}" required>
        </div>
        <div class="ae-contact-field">
          <label for="{{ contact_form_id }}-email">Email <span aria-hidden="true">*</span></label>
          <input id="{{ contact_form_id }}-email" class="field" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" spellcheck="false" value="{{ form.email | escape }}"{% if form.errors contains 'email' %} aria-invalid="true" aria-describedby="{{ contact_error_id }}"{% endif %} required>
        </div>
        <div class="ae-contact-field">
          <label for="{{ contact_form_id }}-topic">Topic</label>
          <select id="{{ contact_form_id }}-topic" class="select" name="contact[topic]">
            {%- for topic in contact_topics -%}<option value="{{ topic | escape }}"{% if form.topic == topic %} selected{% endif %}>{{ topic | escape }}</option>{%- endfor -%}
          </select>
        </div>
        <div class="ae-contact-field">
          <label for="{{ contact_form_id }}-order">Order number <span>(optional)</span></label>
          <input id="{{ contact_form_id }}-order" class="field" type="text" name="contact[order_number]" autocomplete="off" value="{{ form.order_number | escape }}">
        </div>
        <div class="ae-contact-field ae-contact-form__wide">
          <label for="{{ contact_form_id }}-vehicle">Vehicle <span>(optional)</span></label>
          <input id="{{ contact_form_id }}-vehicle" class="field" type="text" name="contact[vehicle]" placeholder="Year, make, model and engine" value="{{ form.vehicle | escape }}">
        </div>
        <div class="ae-contact-field ae-contact-form__wide">
          <label for="{{ contact_form_id }}-body">Message <span aria-hidden="true">*</span></label>
          <textarea id="{{ contact_form_id }}-body" class="field" name="contact[body]" rows="5" placeholder="What can we help with?" required>{{ form.body | escape }}</textarea>
        </div>
        <div class="ae-contact-form__actions ae-contact-form__wide">
          <button class="button" type="submit">{{ section.settings.button_label | escape }} {% render 'icon', icon: 'arrow' %}</button>
          {%- if shop.privacy_policy.url != blank -%}
            <a class="ae-contact-page__link" href="{{ shop.privacy_policy.url | escape }}">Privacy policy</a>
          {%- endif -%}
        </div>
        {%- endform -%}
      </div>

      <aside class="ae-contact-details" aria-label="Contact details">
        {%- if contact_email != blank -%}
          <div class="ae-contact-details__item">
            <h2>Email</h2>
            <a class="ae-contact-details__address" href="mailto:{{ contact_email | escape }}">{{ contact_email | escape }}</a>
            {%- if section.settings.email_text != blank -%}<p>{{ section.settings.email_text | escape }}</p>{%- endif -%}
          </div>
        {%- endif -%}
        <div class="ae-contact-details__item">
          <h2>Instagram</h2>
          <a class="ae-contact-details__address" href="https://www.instagram.com/autobahnessentials/" target="_blank" rel="noopener noreferrer">@autobahnessentials {% render 'icon', icon: 'arrow' %}<span class="visually-hidden"> (opens in a new tab)</span></a>
          {%- if section.settings.instagram_text != blank -%}<p>{{ section.settings.instagram_text | escape }}</p>{%- endif -%}
        </div>
        {%- if section.settings.response_heading != blank or section.settings.response_text != blank -%}
          <div class="ae-contact-details__item">
            {%- if section.settings.response_heading != blank -%}<h2>{{ section.settings.response_heading | escape }}</h2>{%- endif -%}
            {%- if section.settings.response_text != blank -%}<p>{{ section.settings.response_text | escape }}</p>{%- endif -%}
          </div>
        {%- endif -%}
        {%- if pages['faq'] != blank or pages['fitment'] != blank or contact_shipping_url != blank or contact_returns_url != blank -%}
          <nav class="ae-contact-details__item ae-contact-details__links" aria-label="Support resources">
            <h2>Helpful links</h2>
            {%- if pages['fitment'] != blank -%}<a href="{{ pages['fitment'].url | escape }}">Fitment help {% render 'icon', icon: 'arrow' %}</a>{%- endif -%}
            {%- if contact_shipping_url != blank -%}<a href="{{ contact_shipping_url | escape }}">Shipping {% render 'icon', icon: 'arrow' %}</a>{%- endif -%}
            {%- if contact_returns_url != blank -%}<a href="{{ contact_returns_url | escape }}">Returns {% render 'icon', icon: 'arrow' %}</a>{%- endif -%}
            {%- if pages['faq'] != blank -%}<a href="{{ pages['faq'].url | escape }}">FAQs {% render 'icon', icon: 'arrow' %}</a>{%- endif -%}
          </nav>
        {%- endif -%}
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Autobahn Essentials Support"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact Us"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Introduction",
      "default": "Questions about your order or your next upgrade? Get in touch with the AE team."
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Send your question"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Send Message"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success text",
      "default": "Message received. The AE team will get back to you soon."
    },
    {
      "type": "text",
      "id": "fallback_email",
      "label": "Fallback email",
      "default": "support@autobahnessentials.com"
    },
    {
      "type": "textarea",
      "id": "email_text",
      "label": "Email text",
      "default": "Use email for order questions, fitment details, returns, and product support."
    },
    {
      "type": "textarea",
      "id": "instagram_text",
      "label": "Instagram text",
      "default": "Follow product drops, builds, and behind-the-scenes AE content."
    },
    {
      "type": "text",
      "id": "response_heading",
      "label": "Response heading",
      "default": "Fast, focused replies"
    },
    {
      "type": "textarea",
      "id": "response_text",
      "label": "Response text",
      "default": "Include your vehicle details and order number when relevant so support can move quickly."
    }
  ]
}
{% endschema %}
