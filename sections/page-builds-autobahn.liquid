{% render 'breadcrumbs' %}
{% render 'builds-content', section: section %}

{% schema %}
{
  "name": "Builds page",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Customer builds blog",
      "info": "Published posts with an image and a build or customer build tag appear in the gallery."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Real builds. Real results."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Autobahn Builds"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Hero text",
      "default": "Performance starts with the right platform."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop Build Parts"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Follow Builds"
    },
    {
      "type": "text",
      "id": "instagram_url",
      "label": "Instagram URL",
      "default": "https://www.instagram.com/autobahnessentials/"
    }
  ],
  "presets": [
    {
      "name": "Builds page"
    }
  ]
}
{% endschema %}
