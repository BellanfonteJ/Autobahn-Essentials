<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    {{ 'roboto-latin-400-900.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'montserrat-latin-800-900.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {% render 'seo-meta' %}
    {% render 'structured-data' %}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'favicon-ae.png' | asset_url }}">
    {%- endif -%}

    <style>
      @font-face {
        font-family: "Montserrat";
        font-style: normal;
        font-weight: 800 900;
        font-display: swap;
        src: url("{{ 'montserrat-latin-800-900.woff2' | asset_url }}") format("woff2");
      }

      @font-face {
        font-family: "Roboto";
        font-style: normal;
        font-weight: 400 900;
        font-display: swap;
        src: url("{{ 'roboto-latin-400-900.woff2' | asset_url }}") format("woff2");
      }

      :root {
        --color-background: {{ settings.color_background }};
        --color-surface: {{ settings.color_surface }};
        --color-surface-strong: {{ settings.color_surface_strong }};
        --color-text: {{ settings.color_text }};
        --color-muted: {{ settings.color_muted }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-contrast: {{ settings.color_accent_contrast }};
        --color-line: {{ settings.color_line }};
        --page-width: {{ settings.page_width }}px;
        --font-heading: "Montserrat", Arial Black, Impact, sans-serif;
        --font-body: "Roboto", Arial, sans-serif;
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'browsing.css' | asset_url | stylesheet_tag }}
    {%- if template.name == 'product' -%}
      {{ 'product.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'product-content.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    {{ content_for_header }}
    {%- if page.handle == 'builds' -%}
      {{ 'builds.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    <script src="{{ 'health.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'fitment-data.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'garage.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    {%- if template.name == 'collection' -%}
      {{ 'collection.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'collection.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    {{ 'mobile.css' | asset_url | stylesheet_tag }}
    {%- if template.name == 'product' -%}
      <script src="{{ 'mobile-product.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
  </head>

  <body class="template-{{ template.name | handle }}{% if settings.show_ticker %} has-ticker{% endif %}">
    {% render 'theme-config' %}
    <a class="skip-to-content-link button button--secondary" href="#MainContent">
      {{ 'accessibility.skip_to_content' | t }}
    </a>

    {% section 'header' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {% render 'garage-bar' %}
      {%- assign policy_route_handle = request.path | split: '/' | last -%}
      {%- if policy_route_handle == 'refund-policy' and request.path contains '/policies/' -%}
        {% render 'refund-policy-content', policy_content: content_for_layout %}
      {%- elsif policy_route_handle == 'shipping-policy' and request.path contains '/policies/' -%}
        {% render 'shipping-policy-content', policy_content: content_for_layout %}
      {%- else -%}
        {{ content_for_layout }}
      {%- endif -%}
    </main>

    {% section 'footer' %}

    {% render 'cart-drawer' %}

    {% section 'popup-newsletter' %}

    <button class="back-to-top" type="button" data-back-to-top aria-label="Back to top">
      {% render 'icon', icon: 'arrow' %}
    </button>
  </body>
</html>
