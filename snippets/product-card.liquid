{%- assign sizes = '(min-width: 990px) 25vw, (min-width: 361px) 50vw, 100vw' -%}

<article class="product-card" data-product-card data-product-handle="{{ product.handle | escape }}">
  <a href="{{ product.url }}" class="product-card__media" aria-label="{{ product.title | escape }}">
    {%- if product.featured_media -%}
      {%- assign image_alt = product.featured_media.alt | default: product.title -%}
      {{ product.featured_media | image_url: width: 820 | image_tag: alt: image_alt, loading: 'lazy', decoding: 'async', sizes: sizes, class: 'product-card__image' }}
      {%- if product.media[1] and product.media[1].media_type == 'image' -%}
        {%- assign hover_alt = product.media[1].alt | default: product.title -%}
        {{ product.media[1] | image_url: width: 820 | image_tag: alt: hover_alt, loading: 'lazy', decoding: 'async', sizes: sizes, class: 'product-card__image product-card__image--hover' }}
      {%- endif -%}
    {%- else -%}
      <img src="{{ 'autobahn-hero.svg' | asset_url }}" alt="" width="1800" height="1000" loading="lazy" class="product-card__image">
    {%- endif -%}

    {%- if product.available == false -%}
      <span class="product-card__badge product-card__badge--muted">{{ 'products.product.sold_out' | t }}</span>
    {%- elsif product.metafields.custom.badge != blank -%}
      <span class="product-card__badge">{{ product.metafields.custom.badge.value | default: product.metafields.custom.badge | escape }}</span>
    {%- elsif product.tags contains 'New' -%}
      <span class="product-card__badge">New</span>
    {%- elsif product.price_varies == false and product.compare_at_price > product.price -%}
      <span class="product-card__badge">{{ 'products.product.on_sale' | t }}</span>
    {%- endif -%}
  </a>

  <div class="product-card__info">
    {%- if product.vendor != blank -%}
      <div class="product-card__vendor">{% render 'brand-label', vendor: product.vendor %}</div>
    {%- endif -%}
    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </h3>
    {% render 'price', product: product %}
    {% render 'fitment-badge', product: product, context: 'card' %}
    {%- if product.available and product.has_only_default_variant -%}
      {%- form 'product', product, class: 'product-card__quick-buy' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button class="button button--full" type="submit">{{ 'products.product.quick_buy' | t }}</button>
      {%- endform -%}
    {%- elsif product.available -%}
      <a class="button button--secondary button--full" href="{{ product.url }}">{{ 'products.product.choose_options' | t }}</a>
    {%- else -%}
      <a class="button button--secondary button--full" href="{{ product.url }}">{{ 'products.product.view_details' | t }}</a>
    {%- endif -%}
  </div>
</article>
