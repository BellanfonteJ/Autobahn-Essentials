{%- assign dropdown_label = label | default: 'Contacts' -%}
{%- assign contact_root = routes.root_url | default: '/' -%}
{%- assign contact_root_last = contact_root | slice: -1, 1 -%}
{%- unless contact_root_last == '/' -%}
  {%- assign contact_root = contact_root | append: '/' -%}
{%- endunless -%}
{%- assign returns_url = contact_root | append: 'pages/shipping-returns' -%}
{%- assign contact_url = contact_root | append: 'pages/contact' -%}
{%- if pages['contact'] != blank -%}
  {%- assign contact_url = pages['contact'].url -%}
{%- endif -%}
{%- if pages['shipping-returns'] != blank -%}
  {%- assign returns_url = pages['shipping-returns'].url -%}
{%- elsif pages['returns'] != blank -%}
  {%- assign returns_url = pages['returns'].url -%}
{%- endif -%}

<details class="nav-dropdown nav-dropdown--contacts">
  <summary>
    <span>{{ dropdown_label }}</span>
    <span class="nav-dropdown__chevron" aria-hidden="true"></span>
  </summary>
  <div class="nav-dropdown__menu">
    <a href="{{ contact_url }}">Contact Us</a>
    <a href="{{ returns_url }}">Returns</a>
  </div>
</details>
