{%- assign field_prefix = prefix | default: 'Garage' -%}
{%- assign field_names = 'make,model,chassis,trim,variant' | split: ',' -%}
{%- for field_name in field_names -%}
  {%- case field_name -%}
    {%- when 'make' -%}{%- assign field_label = 'Make' -%}
    {%- when 'model' -%}{%- assign field_label = 'Model / platform' -%}
    {%- when 'chassis' -%}{%- assign field_label = 'Chassis' -%}
    {%- when 'trim' -%}{%- assign field_label = 'Engine' -%}
    {%- when 'variant' -%}{%- assign field_label = 'Submodel / drive' -%}
  {%- endcase -%}
  <div class="garage-field">
    <label for="{{ field_prefix }}-{{ field_name }}">{{ field_label }}</label>
    <select class="select" id="{{ field_prefix }}-{{ field_name }}" name="vehicle_{{ field_name }}" data-garage-input="{{ field_name }}"{% unless field_name == 'make' %} disabled{% endunless %}>
      <option value="">{{ field_label }}</option>
    </select>
  </div>
{%- endfor -%}
<div class="garage-field">
  <label for="{{ field_prefix }}-year">Year (optional)</label>
  <input class="field" id="{{ field_prefix }}-year" name="vehicle_year" type="number" min="1900" step="1" inputmode="numeric" placeholder="Year">
</div>
<p class="form-error garage-form__message" data-garage-error role="alert" hidden></p>
