<div
  id="MyGarage"
  class="garage-drawer"
  data-garage-drawer
>
  <div class="page-width garage-drawer__inner">
    <div class="garage-drawer__intro">
      <div class="eyebrow">My Garage</div>
      <h2 data-garage-title>No vehicle saved</h2>
      <p data-garage-summary>Save your vehicle details to check fitment across the shop.</p>
      <button class="icon-button garage-drawer__close" type="button" data-garage-close aria-label="Close My Garage">
        {% render 'icon', icon: 'close' %}
      </button>
    </div>

    <div class="garage-drawer__workspace">
      <div class="garage-vehicles__heading">
        <h3>{{ 'sections.multi_vehicle_garage.vehicles' | t }} <span class="garage-vehicles__count" data-garage-count>0</span></h3>
        <button class="button button--secondary" type="button" data-garage-add>
          <span aria-hidden="true">+</span> {{ 'sections.multi_vehicle_garage.add_vehicle' | t }}
        </button>
      </div>
      <fieldset class="garage-vehicles">
        <legend class="visually-hidden">{{ 'sections.multi_vehicle_garage.vehicles' | t }}</legend>
        <div class="garage-vehicles__list" data-garage-vehicles></div>
        <p class="garage-vehicles__empty" data-garage-vehicles-empty>{{ 'sections.multi_vehicle_garage.empty_title' | t }}</p>
      </fieldset>
      <template data-garage-vehicle-template>
        <div class="garage-vehicle" data-garage-vehicle>
          <label class="garage-vehicle__choice">
            <input type="radio" name="garage_active_vehicle" data-garage-select>
            <span class="garage-vehicle__copy">
              <span data-garage-vehicle-name></span>
              <span class="garage-vehicle__active" data-garage-active-label hidden>{{ 'sections.multi_vehicle_garage.active' | t }}</span>
            </span>
          </label>
          <div class="garage-vehicle__actions">
            <button class="icon-button" type="button" data-garage-edit data-label="{{ 'sections.multi_vehicle_garage.edit_vehicle' | t | escape }}" aria-label="{{ 'sections.multi_vehicle_garage.edit_vehicle' | t | escape }}">
              {% render 'icon', icon: 'edit' %}
            </button>
            <button class="icon-button" type="button" data-garage-remove data-label="{{ 'sections.multi_vehicle_garage.remove_vehicle' | t | escape }}" aria-label="{{ 'sections.multi_vehicle_garage.remove_vehicle' | t | escape }}">
              {% render 'icon', icon: 'close' %}
            </button>
          </div>
        </div>
      </template>
      <form class="garage-form" data-garage-form>
        <h3 class="garage-form__heading" data-garage-editor-title data-add-label="{{ 'sections.multi_vehicle_garage.details' | t | escape }}" data-edit-label="{{ 'sections.multi_vehicle_garage.edit_vehicle' | t | escape }}">{{ 'sections.multi_vehicle_garage.details' | t }}</h3>
        <div class="garage-step-controls" data-garage-step-controls hidden>
          <button class="icon-button" type="button" data-garage-step-back aria-label="Previous vehicle detail" title="Previous vehicle detail">{% render 'icon', icon: 'arrow' %}</button>
          <progress data-garage-step-progress max="6" value="1" aria-label="Vehicle details progress"></progress>
          <span data-garage-step-status role="status"></span>
        </div>
        <ul class="garage-step-summary" data-garage-step-summary hidden aria-label="Selected vehicle details"></ul>
        {% render 'garage-fields', prefix: 'Garage' %}

        <div class="garage-form__actions">
          <button class="button" type="submit" data-save-label="{{ 'sections.multi_vehicle_garage.save' | t | escape }}" data-edit-label="{{ 'sections.multi_vehicle_garage.save_changes' | t | escape }}">{{ 'sections.multi_vehicle_garage.save' | t }}</button>
          <button class="button button--secondary" type="button" data-garage-shop>Find Parts</button>
          <button class="button button--secondary" type="button" data-garage-clear>{{ 'sections.multi_vehicle_garage.clear_active' | t }}</button>
          <button class="button button--secondary" type="button" data-garage-cancel hidden>{{ 'sections.multi_vehicle_garage.cancel' | t }}</button>
        </div>
      </form>
    </div>
  </div>
</div>
