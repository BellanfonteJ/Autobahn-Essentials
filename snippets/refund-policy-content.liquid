{%- assign policy_support_email = shop.email | strip -%}
{% render 'breadcrumbs' %}
<section class="ae-contact-page ae-refund-policy-page">
  <div class="page-width ae-refund-policy-grid">
    <div class="eyebrow ae-refund-policy-eyebrow">{{ shop.name | escape }} Support</div>
    {{ policy_content }}
    <aside class="ae-contact-details ae-refund-policy-support" aria-label="Refund policy support">
      {%- if policy_support_email != blank -%}
        <div class="ae-contact-details__item">
          <h2>Email support</h2>
          <a class="ae-contact-details__address" href="mailto:{{ policy_support_email | escape }}">{{ policy_support_email | escape }}</a>
          <p>Include your order number and item details when contacting support.</p>
        </div>
      {%- endif -%}
      <div class="ae-contact-details__item">
        <h2>Before sending an item back</h2>
        <p>Contact support for review and return instructions before shipping your item.</p>
      </div>
      {%- if pages['returns'] != blank or pages['contact'] != blank or shop.shipping_policy.url != blank -%}
        <nav class="ae-contact-details__item ae-contact-details__links" aria-label="Refund policy resources">
          <h2>Helpful links</h2>
          {%- if pages['returns'] != blank -%}<a href="{{ pages['returns'].url | escape }}">Return request {% render 'icon', icon: 'arrow' %}</a>{%- endif -%}
          {%- if pages['contact'] != blank -%}<a href="{{ pages['contact'].url | escape }}">Contact Us {% render 'icon', icon: 'arrow' %}</a>{%- endif -%}
          {%- if shop.shipping_policy.url != blank -%}<a href="{{ shop.shipping_policy.url | escape }}">Shipping policy {% render 'icon', icon: 'arrow' %}</a>{%- endif -%}
        </nav>
      {%- endif -%}
    </aside>
  </div>
</section>
