{%- assign badge_context = context | default: 'card' -%}

<button
  class="fitment-badge fitment-badge--{{ badge_context }}"
  type="button"
  data-fitment-badge
  data-garage-open
  data-product-handle="{{ product.handle | escape }}"
>
  {% render 'icon', icon: 'garage' %}
  <span data-fitment-badge-text>{{ 'products.product.fitment_check' | t }}</span>
</button>
